{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://miguelcastroe.github.io/content-composer/spec/composer-production-spec.v1.schema.json",
  "title": "Composer Production Spec v1",
  "type": "object",
  "required": ["version", "piece_id", "brand", "format", "zones"],
  "properties": {
    "version": { "const": "1.0" },
    "piece_id": { "type": "string", "minLength": 1 },
    "brand": { "type": "string", "minLength": 1 },
    "format": { "enum": ["storyboard-16x9", "single-4x5"] },
    "input_mode": { "enum": ["full", "separate", "single"] },
    "frame_count": { "enum": [1, 3, 4] },
    "numbering": { "type": "boolean", "default": true },
    "gutter": { "type": "integer", "minimum": 0, "maximum": 40, "default": 8 },
    "source_image_url": { "type": ["string", "null"], "format": "uri" },
    "frame_image_urls": {
      "type": "array",
      "items": { "type": "string", "format": "uri" },
      "maxItems": 4
    },
    "protected_areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["kind", "x", "y", "width", "height"],
        "properties": {
          "kind": { "enum": ["face", "product", "action", "number", "custom"] },
          "frame": { "type": "integer", "minimum": 1, "maximum": 4 },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
        }
      }
    },
    "zones": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["text", "position", "size", "weight", "color"],
        "properties": {
          "frame": { "type": "integer", "minimum": 1, "maximum": 4 },
          "text": { "type": "string" },
          "position": {
            "enum": [
              "top-left", "top-center", "top-right",
              "middle-left", "middle-center", "middle-right",
              "bottom-left", "bottom-center", "bottom-right"
            ]
          },
          "size": { "type": "integer", "minimum": 18, "maximum": 120 },
          "weight": { "enum": [300, 400, 500, 600, 700] },
          "color": { "enum": ["#ffffff", "#111111"] }
        }
      }
    },
    "qa": {
      "type": "object",
      "properties": {
        "protect_faces": { "type": "boolean", "default": true },
        "protect_products": { "type": "boolean", "default": true },
        "protect_actions": { "type": "boolean", "default": true },
        "hero_layout": { "type": "boolean", "default": true }
      }
    }
  }
}